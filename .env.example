# GEMINI_API_KEY: Optional for future AI modules.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TWELVE_DATA_API_KEY: Optional server-side API key for Twelve Data Forex & XAU/USD real-time feeds.
# When omitted, the engine uses Swissquote BBO (real Bid/Ask) + Yahoo Finance OHLC real market feeds.
TWELVE_DATA_API_KEY=""

# VAPID keys for Web Push background notifications (auto-generated on server if omitted).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@forex-intelligence.local"

# Server & Scheduler configuration
PORT=3000
CRON_ENABLED="true"
